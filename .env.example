# PostgreSQL connection string (local dev default)
# Leave UNSET to run in demo mode (in-memory data, no database needed).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Force demo mode even when DATABASE_URL is set ("1" = demo, unset/other = real DB).
# The committed .env.production sets this so the deployed demo never touches a DB.
DEMO_MODE=

# Secret used to sign session JWTs. Generate with: openssl rand -hex 32
AUTH_SECRET=
