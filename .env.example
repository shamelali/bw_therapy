# PostgreSQL connection string (local dev default)
# Leave UNSET to run in demo mode (in-memory data, no database needed).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Force demo mode even when DATABASE_URL is set ("1" = demo, unset/other = real DB).
# The committed .env.production sets this so the deployed demo never touches a DB.
DEMO_MODE=

# Secret used to sign session JWTs. Generate with: openssl rand -hex 32
AUTH_SECRET=

# ── Social login (demo build) ───────────────────────────────────────────────
# The demo build provides one-click "Continue with Google / Apple / Facebook /
# Instagram" login WITHOUT an account or real OAuth credentials: a sequence of
# requests to POST /api/auth/social creates a guest customer and issues a
# session. No env vars are required for this to work.
#
# If you later wire real OAuth, the next-auth handler at /api/auth also reads
# these credentials (google / apple / facebook / instagram):
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# APPLE_CLIENT_ID=
# APPLE_CLIENT_SECRET=
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=
# INSTAGRAM_CLIENT_ID=
# INSTAGRAM_CLIENT_SECRET=
# NEXTAUTH_SECRET=
# NEXTAUTH_URL=
